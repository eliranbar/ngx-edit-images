{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/ngx-image-editor",
  "allowedNonPeerDependencies": [
    "@jsquash/avif",
    "@noble/ed25519",
    "@noble/hashes",
    "gifenc",
    "pdfjs-dist",
    "utif"
  ],
  "assets": [
    {
      "input": "src/lib/styles",
      "glob": "styles.css",
      "output": "."
    },
    {
      "input": "src/lib/engine/codecs",
      "glob": "*.wasm",
      "output": "assets"
    }
  ],
  "lib": {
    "entryFile": "src/public-api.ts"
  }
}
